# Public Supabase values used by the Vite browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional compatibility aliases
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Connect AI Desk / social integrations
GEMINI_API_KEY=
GEMINI_MODEL=
META_ACCESS_TOKEN=
META_PAGE_ID=
SITE_URL=
DESK_CRON_SECRET=

# Cloudinary Media Library / Upload Widget
# The cloud name and API key are public values used by browser widgets.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=

# Server-side authenticated Cloudinary uploads/signatures
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional legacy unsigned preset (only used as a server-side fallback)
CLOUDINARY_UPLOAD_PRESET=

# Cloudflare cover image generation (server-side)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
