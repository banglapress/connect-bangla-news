# Public Supabase values used by the Vite browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional compatibility aliases
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Connect AI Desk / social integrations
GEMINI_API_KEY=
GEMINI_MODEL=
META_ACCESS_TOKEN=
META_PAGE_ID=
SITE_URL=
DESK_CRON_SECRET=

# Cloudinary media library / uploads
# Cloud name, API key, and unsigned upload preset are safe for browser use.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-side Cloudinary aliases used by AI cover and Facebook card uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Cloudflare cover image generation (server-side)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
